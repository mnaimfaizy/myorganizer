. .husky/common.sh

# Format uncommitted files once, restage so the commit includes the rewrite,

# then lint with static Nx output so failures stay readable for AI tools.
# Prettier does not understand .prisma, so the schema needs its own formatter
# or it drifts silently until some unrelated commit reindents every model.
corepack yarn format:write --uncommitted
(cd apps/backend/src && npx prisma format --schema prisma/schema >/dev/null)
git update-index --again
corepack yarn libs:markdown:check
corepack yarn test:hygiene --staged
if ! git diff --cached --quiet --diff-filter=ACMRT -- \
 libs/web-ui/src/lib/components \
 libs/web/pages
then
corepack yarn component:hygiene --staged --max-warnings=0
fi
corepack yarn affected:lint --uncommitted --outputStyle=static
