. .husky/common.sh

# Format uncommitted files once, restage so the commit includes the rewrite,

# then lint with static Nx output so failures stay readable for AI tools.
# Prettier does not understand .prisma, so the schema needs its own formatter
# or it drifts silently until some unrelated commit reindents every model.
corepack yarn format:write --uncommitted
(cd apps/backend/src && npx prisma format --schema prisma/schema >/dev/null)
git update-index --again
corepack yarn libs:markdown:check
corepack yarn docs:notes:check
corepack yarn adr:numbering:check
# The skill atlas asserts counts and verbatim descriptions about the skill system, so it rots
# the moment a skill is added, renamed, or given a new description. Gated on the sources it
# reads: an unrelated commit must not fail on drift it did not introduce. That list must include
# every input the check grew — the lockfile that names Upstream-Owned Skills, the two config
# files that must cover them, and the script itself. It did not, and the commit that scoped
# .gitattributes slipped through this gate untested as a result.
if ! git diff --cached --quiet --diff-filter=ACMRTD -- \
 .agents/skills \
 .github/agents \
 .claude/agents \
 AGENTS.md \
 docs/agents/skill-atlas.html \
 skills-lock.json \
 .prettierignore \
 .gitattributes \
 tools/scripts/check-skill-map.mjs
then
corepack yarn skills:map:check
fi
# The orchestration map and the journey rail both state a tier per agent, and the map's
# manifest stamps the policy revision it was built against. Nothing invoked this check, so
# the roster drifted and the stamp went stale on main with nobody watching (ADR 0043 names
# it). Gated on every input it reads: the two pages, the policy, the canonical agent bodies
# it takes display names from, and the script itself.
if ! git diff --cached --quiet --diff-filter=ACMRTD -- \
 docs/agents/orchestration-map.html \
 docs/agents/agent-journey.html \
 tools/config/agent-model-policy.json \
 .github/agents \
 tools/scripts/check-agent-map.mjs
then
corepack yarn agents:map:check
fi
corepack yarn test:hygiene --staged
if ! git diff --cached --quiet --diff-filter=ACMRT -- \
 libs/web-ui/src/lib/components \
 libs/web/pages
then
corepack yarn component:hygiene --staged --max-warnings=0
fi
# The sandcastle resume and sub-agent-trace decisions are pure functions with no Nx
# project of their own, so `affected:lint` and `nx affected -t test` never reach them.
# Run their contracts whenever a module or its consumer is staged.
if ! git diff --cached --quiet --diff-filter=ACMRT -- \
 tools/scripts/lib/sandcastle-resume.mjs \
 tools/scripts/lib/sandcastle-resume.test.mjs \
 tools/scripts/lib/sandcastle-subagent-trace.mjs \
 tools/scripts/lib/sandcastle-subagent-trace.test.mjs \
 .sandcastle/main.mts \
 .sandcastle/dispatch-waves.mts
then
corepack yarn sandcastle:resume:test
corepack yarn sandcastle:subagent-trace:test
fi
# The five sandcastle atlas pages state constants that live as module-local literals in the
# two orchestrator files, as exports in sandcastle-resume.mjs and sandcastle-subagent-trace.mjs,
# and as JSON in the model policy and package.json. They rot the moment any of those move, and
# the checker passed green through the whole of #467 precisely because it asserted constants
# while the prose went false around them — so the guard must list every input it reads, plus
# the pages and the check script themselves, or an unrelated commit is failed by drift it did
# not introduce and a related one slips through untested.
if ! git diff --cached --quiet --diff-filter=ACMRTD -- \
 docs/sandcastle/dispatch-map.html \
 docs/sandcastle/waves.html \
 docs/sandcastle/gates.html \
 docs/sandcastle/logs.html \
 docs/sandcastle/resume.html \
 tools/scripts/check-sandcastle-map.mjs \
 tools/scripts/lib/sandcastle-resume.mjs \
 tools/scripts/lib/sandcastle-subagent-trace.mjs \
 tools/config/agent-model-policy.json \
 package.json \
 .sandcastle/main.mts \
 .sandcastle/dispatch-waves.mts
then
corepack yarn sandcastle:map:check
fi
# The merge-base proof gate is a pure function with no Nx project of its own, so
# `affected:lint` and `nx affected -t test` never reach it. It is the only thing
# standing between a fabricated PrAuthor draft and GitHub (#456), so run its contracts
# whenever the gate or the runner that calls it is staged.
if ! git diff --cached --quiet --diff-filter=ACMRT -- \
 tools/scripts/lib/pr-merge-base.mjs \
 tools/scripts/lib/pr-merge-base.test.mjs \
 tools/scripts/ai/create-pr.mjs
then
corepack yarn ai:create-pr:test
fi
corepack yarn affected:lint --uncommitted --outputStyle=static
