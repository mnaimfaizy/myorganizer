# Enforce consistent line endings across platforms.
# Default all text files to LF in the repository.
* text=auto eol=lf

# Windows-specific scripts keep CRLF for better local UX.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common binary assets as binary (no EOL conversion).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary

# Upstream-Owned Skills (ADR 0030): preserve upstream content exactly as installed, and keep
# their diffs collapsed since nobody reviews them line by line. Repo-native skills are excluded
# deliberately — they are hand-written instruction files, and marking them generated hid their
# diffs from review. Keep in step with skills-lock.json; check-skill-map.mjs asserts it.
.agents/skills/codebase-design/** linguist-generated=true whitespace=-trailing-space
.agents/skills/handoff/** linguist-generated=true whitespace=-trailing-space
.agents/skills/modern-web-guidance/** linguist-generated=true whitespace=-trailing-space
.agents/skills/prototype/** linguist-generated=true whitespace=-trailing-space
