{
  "name": "email-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/email-shell/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project email-shell --web",
  "targets": {
    "build-logo": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/assets"],
      "inputs": [
        "{workspaceRoot}/apps/myorganizer/public/images/logo-email.svg",
        "{projectRoot}/scripts/build-logo.mjs"
      ],
      "options": {
        "cwd": "libs/email-shell",
        "command": "node scripts/build-logo.mjs"
      }
    }
  }
}
