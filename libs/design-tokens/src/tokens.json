  "$description": "MyOrganizer design tokens. Single source of truth for color, spacing, radius, typography, and shadow. See libs/design-tokens/README.md.",
  "neutral": {
    "$description": "Ordered greyscale both colour modes index into. Light mode reads it from the top, dark mode inverted. Token data only — never exposed as Tailwind utilities.",
    "0": {
      "$value": "#FFFFFF",
      "$type": "color"
    },
    "50": {
      "$value": "#F8FAFC",
      "$type": "color"
    },
    "150": {
      "$value": "#ECEEF0",
      "$type": "color"
    },
    "200": {
      "$value": "#E2E8F0",
      "$type": "color"
    },
    "400": {
      "$value": "#94A3B8",
      "$type": "color"
    },
    "450": {
      "$value": "#7F8EA3",
      "$type": "color"
    },
    "500": {
      "$value": "#64748B",
      "$type": "color"
    },
    "800": {
      "$value": "#1D283A",
      "$type": "color"
    },
    "850": {
      "$value": "#0F172A",
      "$type": "color"
    },
    "900": {
      "$value": "#030711",
      "$type": "color"
    },
    "950": {
      "$value": "#020205",
      "$type": "color"
    }
