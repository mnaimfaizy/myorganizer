{
  "name": "design-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-tokens/src",
  "projectType": "library",
  "tags": ["type:util", "scope:shared", "tier:agent"],
  "targets": {
    "build-tokens": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/generated"],
      "inputs": [
        "{projectRoot}/src/tokens.json",
        "{projectRoot}/scripts/build-tokens.cjs"
      ],
      "options": {
        "cwd": "libs/design-tokens",
        "command": "node scripts/build-tokens.cjs"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "nx run design-tokens:build-tokens",
          "node tools/scripts/git-assert-clean.mjs design-tokens-check"
        ],
        "parallel": false
      }
    }
  }
}
