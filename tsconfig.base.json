        "libs/web/pages/subscriptions/src/index.ts"
      ],
      "@myorganiser/web-pages/tasks": ["libs/web/pages/tasks/src/index.ts"],
      "@myorganiser/web-pages/vault": ["libs/web/pages/vault/src/index.ts"],
      "@myorganiser/web-pages/youtube": ["libs/web/pages/youtube/src/index.ts"],
      "@myorganiser/web-ui": ["libs/web/ui/src/index.ts"],
      "@myorganiser/web-vault": ["libs/web/vault/src/index.ts"],
      "@myorganiser/web-vault-ui": ["libs/web/vault-ui/src/index.ts"],
