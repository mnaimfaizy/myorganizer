      "@myorganiser/auth": ["libs/auth/src/index.ts"],
      "@myorganiser/auth/portable": ["libs/auth/src/portable.ts"],
      "@myorganiser/core": ["libs/core/src/index.ts"],
      "@myorganiser/design-tokens": ["libs/design-tokens/src/index.ts"],
      "@myorganiser/email-shell": ["./libs/email-shell/src/index.ts"],
      "@myorganiser/mobile/core": ["libs/mobile/core/src/index.ts"],
      "@myorganiser/mobile/feat-auth": ["libs/mobile/feat/auth/src/index.ts"],
      "@myorganiser/mobile/feat-vault": ["libs/mobile/feat/vault/src/index.ts"],
      "@myorganiser/mobile/hooks": ["libs/mobile/hooks/src/index.ts"],
      "@myorganiser/mobile/screens": ["libs/mobile/screens/src/index.ts"],
      "@myorganiser/mobile/ui": ["libs/mobile/ui/src/index.ts"],
      "@myorganiser/mobile/utils": ["libs/mobile/utils/src/index.ts"],
      "@myorganiser/vault-core": ["libs/vault-core/src/index.ts"],
      "@myorganiser/vault-core/portable": ["libs/vault-core/src/portable.ts"],
      "@myorganiser/web-pages/account": ["libs/web/pages/account/src/index.ts"],
      "@myorganiser/web-pages/addresses": [
        "libs/web/pages/addresses/src/index.ts"
      ],
      "@myorganiser/web-pages/admin": ["libs/web/pages/admin/src/index.ts"],
      "@myorganiser/web-pages/dashboard": [
        "libs/web/pages/dashboard/src/index.ts"
      ],
      "@myorganiser/web-pages/groceries": [
        "libs/web/pages/groceries/src/index.ts"
      ],
      "@myorganiser/web-pages/home": ["libs/web/pages/home/src/index.ts"],
      "@myorganiser/web-pages/download": [
        "libs/web/pages/download/src/index.ts"
      ],
