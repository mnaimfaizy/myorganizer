{
  "name": "myorganizer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/myorganizer",
  "projectType": "application",
  "tags": ["type:app", "scope:web", "tier:agent"],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "node -e \"const fs=require('fs'); const path=require('path'); fs.rmSync(path.resolve('apps/myorganizer/.next'), { recursive: true, force: true });\""
        ],
        "parallel": false
      }
    },
    "build": {
      "dependsOn": ["clean"],
      "options": {
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["clean"],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "yarn nx run myorganizer:build",
          "node tools/scripts/package-myorganizer-web.mjs"
        ]
      }
    }
  }
}
