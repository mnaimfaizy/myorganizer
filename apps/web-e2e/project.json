{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-e2e/src",
  "tags": ["type:e2e", "scope:web", "tier:agent"],
  "implicitDependencies": ["web"],
  "// targets": "to see all targets run: nx show project web-e2e --web",
  "targets": {
    "e2e": {
      "cache": false,
      "options": {
        "args": ["--project=chromium"]
      }
    },
    "e2e-firefox": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "playwright test --project=firefox"
      }
    },
    "e2e-webkit": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "playwright test --project=webkit"
      }
    },
    "e2e-all": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "npx nx run web-e2e:e2e",
          "npx nx run web-e2e:e2e-firefox",
          "npx nx run web-e2e:e2e-webkit"
        ]
      }
    }
  }
}
