{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["type:app", "scope:backend", "tier:human"],
  "targets": {
    "build": {
      "dependsOn": ["generate-types"]
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "yarn nx build backend",
          "node tools/scripts/package-backend-api.mjs"
        ]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "dependsOn": ["generate-types"],
      "options": {
        "buildTarget": "backend:build",
        "watch": true
      }
    },
    "test": {
      "dependsOn": ["generate-types"]
    },
    "prisma": {
      "command": "prisma --schema prisma/schema",
      "options": {
        "cwd": "apps/backend/src"
      }
    },
    "migrate": {
      "command": "prisma migrate dev --schema prisma/schema",
      "options": {
        "cwd": "apps/backend/src"
      }
    },
    "generate-types": {
      "command": "prisma generate --schema prisma/schema",
      "options": {
        "cwd": "apps/backend/src"
      }
    }
  }
}
